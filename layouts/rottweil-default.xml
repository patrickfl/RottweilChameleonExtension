<?xml version="1.0" encoding="utf-8"?>
<structure xmlns="https://cmln.github.io/chameleon/schema/1.0/layout.rng">

	<grid mode="fluid">
		<row>
			<cell span="12">
				<component type="PersonalTools" hideNewtalkNotifier="yes" class="float-end"/>
			</cell>
		</row>
		<row class="rw-header-row">
			<cell span="8" class="rw-logo-cell">
				<component type="Logo"/>
			</cell>
			<cell span="4" class="rw-search-cell">
				<component type="SearchBar" class="float-end"/>
			</cell>
		</row>
		<row>
			<cell span="12" class="col-lg-3 col-md-12">
				<component type="Aside" flatten="navigation" showTools="no" showLanguages="no"/>
			</cell>
			<cell span="12" class="col-lg-9 col-md-12">
				<component type="NavigationContent"/>
				<component type="SiteNotice"/>
				<component type="MainContent"/>
			</cell>
		</row>

	</grid>

</structure>
