<?xml version="1.0" encoding="utf-8"?>
<structure xmlns="https://cmln.github.io/chameleon/schema/1.0/layout.rng">

	<grid mode="fluid">
		<row>
			<cell span="12">
				<component type="PersonalTools" hideNewtalkNotifier="yes" class="float-end"/>
			</cell>
		</row>
		<row>
			<cell span="9">
				<component type="Logo"></component>
			</cell>
			<cell span="3">
				<component type="SearchBar" class="float-end"/>
			</cell>
		</row>
		<row>
			<cell span="12" class="col-lg-3 col-md-12">
				<component type="Aside" flatten="navigation" showTools="no" showLanguages="no"></component>
			</cell>
			<cell span="12" class="col-lg-9 col-md-12">
				<component type="NavigationContent"></component>
				<component type="SiteNotice"></component>
				<component type="MainContent"></component>
			</cell>
		</row>

	</grid>

</structure>
